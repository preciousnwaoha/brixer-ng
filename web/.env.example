# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
SUPABASE_EMAIL_HOOK_SECRET=
SUPABASE_SMS_HOOK_SECRET=

# Paystack
# Server-only key. Hosted checkout does not require a public key.
PAYSTACK_SECRET_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=brixer
R2_REGION=auto

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=The Brand Fixer <notifications@mail.brixer.ng>

# Optional WhatsApp Cloud API (disabled by default)
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_AUTH_TEMPLATE=
WHATSAPP_UPDATE_TEMPLATE=brixer_order_update
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_VERSION=v23.0

# Phone OTP delivery (server-only). Match Supabase Auth SMS OTP expiry.
# Generate a 32-byte hexadecimal secret: openssl rand -hex 32
AUTH_OTP_DELIVERY_KEY=
AUTH_OTP_EXPIRY_SECONDS=600
# Termii account-specific HTTPS base URL and approved transactional sender.
TERMII_API_KEY=
TERMII_BASE_URL=
TERMII_SENDER_ID=
